{
  "manifest_version": 3,
  "name": "CheckAM - Verify it",
  "version": "1.0",
  "description": "Real-time collaborative political fact-checking overlay for Africa.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://verinote-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
